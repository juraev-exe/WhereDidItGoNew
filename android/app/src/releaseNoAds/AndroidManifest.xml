<?xml version="1.0" encoding="utf-8" ?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!--
        When no live AdMob Application ID is configured for release, strip AdMob
        test metadata, MobileAdsInitProvider, and advertising-ID permissions so
        Play Console's "No ads" / "No AD_ID" declarations stay consistent and
        no test AdMob App ID ships in the release bundle.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            tools:node="remove" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            tools:node="remove" />

        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="${applicationId}.mobileadsinitprovider"
            tools:node="remove" />

        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.ads.OutOfContextTestingActivity"
            tools:node="remove" />
        <activity
            android:name="com.google.android.gms.ads.NotificationHandlerActivity"
            tools:node="remove" />
        <service
            android:name="com.google.android.gms.ads.AdService"
            tools:node="remove" />
    </application>
</manifest>
