<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Top Row: Overall balance label and Quick Add button -->
    <LinearLayout
        android:id="@+id/widget_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_overall_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_overall_balance"
            android:textColor="#9E9EA6"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/widget_quick_add_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_button_add_small_bg"
            android:src="@drawable/ic_widget_add"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="@string/widget_quick_add_title" />
    </LinearLayout>

    <!-- Large Overall Balance Amount -->
    <TextView
        android:id="@+id/widget_balance_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header_row"
        android:layout_marginTop="4dp"
        android:text="@string/widget_placeholder"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <!-- Bottom Breakdown Row: Expenses and Incomes -->
    <LinearLayout
        android:id="@+id/widget_breakdown_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <!-- Expenses Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_expenses_label"
                android:textColor="#F87171"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_spend_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_placeholder"
                android:textColor="#F87171"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Incomes Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_incomes_label"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_income_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/widget_placeholder"
                android:textColor="#34D399"
                android:textSize="15sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
