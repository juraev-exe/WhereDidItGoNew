# Template for android/keystore.properties (release signing credentials).
#
# 1. Generate a release keystore once (keep it forever — losing it means you can
#    never publish an update to the same Play Store listing again):
#      keytool -genkeypair -v -storetype PKCS12 -keystore wherediditgo-release.jks ^
#        -alias wherediditgo -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copy this file to android/keystore.properties (same folder) and fill in the
#    real values below. android/keystore.properties is gitignored — never commit it
#    or the .jks/.keystore file itself.
#
# 3. Back up the .jks file and these passwords somewhere safe and offline
#    (password manager, encrypted drive, etc.) — outside this repo.

storeFile=../wherediditgo-release.jks
storePassword=CHANGE_ME
keyAlias=wherediditgo
keyPassword=CHANGE_ME
